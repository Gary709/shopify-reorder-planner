# Copy to .env and restart `npm run dev` to read a real shop.
# Leave the token empty to run on the bundled synthetic sample.
# Never commit a real token. .env is gitignored.

SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
SHOPIFY_ADMIN_TOKEN=

# Admin GraphQL version. 2026-10 matches the fields this client queries.
SHOPIFY_API_VERSION=2026-10

# Days of orders pulled from Shopify. The planner cannot look back further
# than this without a refetch, and it will not zero-fill days before it.
SHOPIFY_ORDER_LOOKBACK_DAYS=180

# API port. The Vite dev server proxies /api to this port.
PORT=8787
